{
  "buildCommand": "npm run build:prod",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": ".next",
  "env": {
    "NODE_ENV": "production",
    "ENVIRONMENT": "production"
  },
  "crons": [
    {
      "path": "/api/cron/sync-supplier-stock",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 2 * * *"
    }
  ]
}