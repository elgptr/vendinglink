# =============================================================================
# VENDING MACHINE LINK REDEEM — Environment Variables
# =============================================================================
# Copy this file as .env and fill in your actual values.
# NEVER commit your actual .env file to version control!
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development — zero config)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production — recommended)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vending_machine?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="rahasia-super-aman-ganti-ini-dengan-32-karakter-random"
NEXTAUTH_URL="http://localhost:3000"

# ─── Midtrans ─────────────────────────────────────────────────────────────────
# Get your keys from: https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx-xxxxx-xxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx-xxxxx-xxxxx"

# Set to "true" for production environment
MIDTRANS_IS_PRODUCTION="false"

# ─── App Config ───────────────────────────────────────────────────────────────
# Base URL used for webhook notifications (must be publicly accessible)
# For local testing, use a tunnel like ngrok: https://ngrok.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Anthropic (AI Chat Assistant) ────────────────────────────────────────────
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-xxxxx-xxxxx-xxxxx"
