# =============================================================================
# VENDING MACHINE LINK REDEEM — Environment Variables
# =============================================================================
# Copy this file as .env and fill in your actual values.
# NEVER commit your actual .env file to version control!
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development — zero config)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production — recommended)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vending_machine?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="rahasia-super-aman-ganti-ini-dengan-32-karakter-random"
NEXTAUTH_URL="http://localhost:3000"

# ─── Database Seeding (Development Only) ───────────────────────────────────────
# Optional: Set fixed passwords for seed data. If not set, random passwords are generated.
# ⚠️  NEVER use these in production — use change-password.js instead!
# SEED_ADMIN_PASSWORD="your-secure-admin-password"
# SEED_AGENT_PASSWORD="your-secure-agent-password"

# ─── Midtrans ─────────────────────────────────────────────────────────────────
# Get your keys from: https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx-xxxxx-xxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx-xxxxx-xxxxx"

# Client key exposed to the browser for Snap.js (safe to expose — it's a
# publishable key, same value as MIDTRANS_CLIENT_KEY above).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx-xxxxx-xxxxx"

# Set to "true" for production environment
MIDTRANS_IS_PRODUCTION="false"

# Mirrors MIDTRANS_IS_PRODUCTION but readable from the browser, so Snap.js
# loads from the correct host (sandbox vs production).
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# ─── App Config ───────────────────────────────────────────────────────────────
# Base URL used for webhook notifications (must be publicly accessible)
# For local testing, use a tunnel like ngrok: https://ngrok.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Gemini (AI Chat Assistant) ────────────────────────────────────────────
# Free tier, no credit card required. Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSy-xxxxx-xxxxx-xxxxx"

# ─── Anthropic (AI Product Description & Sales Insight — paid) ───────────────
# Used only by admin features: generate product description, sales insight report.
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-xxxxx-xxxxx-xxxxx"

# ─── Encryption (AI API Key Management) ────────────────────────────────────────
# AES-256-CBC encryption key for storing API keys securely
# Generate a 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY="your-64-character-hex-key-here"

# ─── Saungwa WhatsApp Notifications ─────────────────────────────────────────
# App key & auth key from the Saungwa dashboard: https://app.saungwa.com/user/app/integration/
# ⚠️  NEVER commit your actual keys — keep them only in .env (gitignored)
# SAUNGWA_APPKEY="your-app-key-here"
# SAUNGWA_AUTHKEY="your-auth-key-here"

# Mode: "live" (production — sends real WhatsApp messages)
#        "mock" (development — logs messages instead of calling API)
SAUNGWA_MODE="mock"
