# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy these values to Vercel Project Settings → Environment Variables
# NEVER expose these values publicly or commit to git!
# =============================================================================

# ─── Node & Next.js ───────────────────────────────────────────────────────
NODE_ENV=production
ENVIRONMENT=production

# ─── Database (PostgreSQL — Production) ───────────────────────────────────
# Use Neon, Railway, Supabase, or your managed PostgreSQL provider
# DATABASE_URL should be your pooling connection (for serverless functions)
# DIRECT_URL should be your direct connection (for migrations, schema introspection)
DATABASE_URL="postgresql://user:password@pooler.region.provider.com:6543/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.provider.com:5432/database?sslmode=require"

# ─── NextAuth (Session Management) ────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-production-secret-here-generate-random-32-chars"
NEXTAUTH_URL="https://your-production-domain.com"

# ─── Midtrans (Payment Gateway — Production) ──────────────────────────────
# Get your keys from: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY="Mid-server-xxxxx-xxxxx-xxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxx-xxxxx-xxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxxxx-xxxxx-xxxxx"
MIDTRANS_IS_PRODUCTION="true"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="true"

# ─── App Configuration ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# ─── Optional: AI Features (Claude & Gemini) ──────────────────────────────
# These are optional; leave blank if not using AI features
# GEMINI_API_KEY="AIzaSy-xxxxx-xxxxx-xxxxx"
# ANTHROPIC_API_KEY="sk-ant-xxxxx-xxxxx-xxxxx"
# ENCRYPTION_KEY="your-64-character-hex-key-here"

# ─── Optional: WhatsApp Notifications (WhatsVA) ────────────────────────────
# WHATSVA_DEVICE_TOKEN="your-whatsva-device-token"
# WHATSVA_MODE="live"

# =============================================================================
# NOTES
# =============================================================================
# 1. All sensitive values should be stored ONLY in Vercel dashboard, not here.
# 2. Do NOT commit this file with real values to git.
# 3. For more details, see docs/DEPLOYMENT.md
# 4. After setting up in Vercel, run manual migrations if needed:
#    DATABASE_URL="..." npx prisma migrate deploy
