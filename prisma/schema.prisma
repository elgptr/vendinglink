// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  role            String   @default("AGENT") // 'ADMIN' | 'AGENT'
  isApproved      Boolean  @default(false) // Agents require admin approval before transacting
  isActive        Boolean  @default(true)
  outstandingDebt Int      @default(0) // Debt owed to admin from credit-based agent checkouts
  createdAt       DateTime @default(now())

  // Relations
  transactions  Transaction[]
  claimedStocks RedeemStock[]

  @@map("users")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  price         Int
  originalPrice Int?
  showOriginalPrice Boolean @default(true)
  type          String   @default("LINK") // 'LINK' | 'KODE'
  description   String?
  guideImageUrl String? // Image guide on how to use the redeem link
  guideText     String? // Step-by-step usage instructions (markdown/plain text)
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  // ── Supplier config ──────────────────────────────────────────────────────
  // 'MANUAL'      → use RedeemStock table (existing behaviour)
  // 'DIGITALCORE' → auto-purchase from DigitalCore API at checkout
  // 'AUTO'        → try MANUAL first, fallback to DIGITALCORE if out-of-stock
  supplierMode      String  @default("MANUAL")
  // Slug from the external supplier catalog, e.g. "gemini_pro_18_months"
  supplierProductId String?
  supplierStock         Int       @default(0)
  isSupplierAvailable   Boolean   @default(true)
  supplierLastCheckedAt DateTime?

  // Relations
  stocks       RedeemStock[]
  transactions Transaction[]
  mappings     SupplierProductMapping[]
  stocks             RedeemStock[]
  transactions       Transaction[]
  applicableVouchers Voucher[]     @relation("VoucherProducts")

  @@map("products")
}

model SupplierProductMapping {
  supplierCode      String
  supplierProductId String
  productId         String
  createdAt         DateTime @default(now())

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([supplierCode, supplierProductId])
  @@index([productId])
  @@map("supplier_product_mappings")
}

model RedeemStock {
  id               String    @id @default(cuid())
  productId        String
  redeemUrl        String
  status           String    @default("AVAILABLE") // 'AVAILABLE' | 'SOLD'
  source           String    @default("MANUAL")    // 'MANUAL' | 'BRIDGE'
  bridgeTxId       String?
  claimedByAgentId String?
  customerName     String?
  customerPhone    String?
  claimedAt        DateTime?
  createdAt        DateTime  @default(now())

  // Relations
  product        Product @relation(fields: [productId], references: [id])
  claimedByAgent User?   @relation(fields: [claimedByAgentId], references: [id])

  // Index: stock claim query — productId + status is the hot path in claimAvailableStock()
  @@index([productId, status])
  // Index: agent stock lookup (e.g. list all stocks claimed by a specific agent)
  @@index([claimedByAgentId, status])
  @@map("redeem_stocks")
}

model Voucher {
  id             String    @id @default(cuid())
  code           String    @unique
  discountAmount Int
  quota          Int
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  transactions       Transaction[]
  applicableProducts Product[]     @relation("VoucherProducts")

  @@map("vouchers")
}

model Transaction {
  id             String    @id @default(cuid())
  orderId        String    @unique
  productId      String
  agentId        String? // Nullable for direct customer (B2C) purchases
  voucherId      String?
  customerName   String?
  customerPhone  String?
  paymentType    String    @default("MIDTRANS") // 'MIDTRANS' | 'AGENT_CREDIT'
  originalPrice  Int
  discountAmount Int       @default(0)
  finalAmount    Int
  status         String    @default("PENDING") // 'PENDING' | 'PAID' | 'EXPIRED' | 'CANCELLED'
  // Tracks stock fulfillment outcome at settlement time — distinct from
  // `status` because a MIDTRANS transaction can be PAID (money captured)
  // while stock ran out (OUT_OF_STOCK), which triggers the promo code
  // compensation flow instead of handing out a redeem link.
  stockStatus    String    @default("PENDING") // 'PENDING' | 'FULFILLED' | 'OUT_OF_STOCK'
  isSettled      Boolean   @default(false) // For agent debt tracking
  redeemUrl      String?
  promoCodeId    String? // Set when stock ran out and a customer refund promo was issued
  qrString       String?
  qrCodeUrl      String?
  snapToken      String?
  createdAt      DateTime  @default(now())
  paidAt         DateTime?

  // Relations
  product   Product    @relation(fields: [productId], references: [id])
  agent     User?      @relation(fields: [agentId], references: [id])
  voucher   Voucher?   @relation(fields: [voucherId], references: [id])
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id])

  // Index: admin reports filter — status + paidAt covers the most common query
  @@index([status, paidAt])
  // Index: agent debt dashboard — agentId + paymentType + isSettled
  @@index([agentId, paymentType, isSettled])
  // Index: customer order lookup by phone — customerPhone + status
  @@index([customerPhone, status])
  // Index: product sales analytics — productId + status
  @@index([productId, status])
  @@map("transactions")
}

model AIConfiguration {
  id                  String    @id @default(cuid())
  
  // Custom AI provider config (OpenRouter, 9Router, etc)
  baseUrl             String?   // Base URL (e.g., https://toko.txsiber.online/v1)
  apiKey              String?   // Encrypted API key
  chatModel           String?   // Model for chat (e.g., kr/claude-sonnet-4.5)
  descriptionModel    String?   // Model for product description generation
  
  updatedAt           DateTime  @updatedAt
  updatedBy           String?   // Admin username who last updated
  createdAt           DateTime  @default(now())

  @@map("ai_configurations")
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  // Discount is expressed as a flat Rupiah amount (matches Voucher.discountAmount
  // semantics). For a stockout refund this is set equal to the original
  // transaction's finalAmount, so applying it nets the customer a free order.
  discount  Int
  type      String    @default("STOCKOUT_REFUND") // 'STOCKOUT_REFUND'
  isActive  Boolean   @default(true)
  usedAt    DateTime?
  expiresAt DateTime? // 30 days from issuance
  createdAt DateTime  @default(now())

  // Relations
  transactions Transaction[]

  @@map("promo_codes")
}

// ── Supplier integration config ─────────────────────────────────────────────
// Stores per-provider runtime state (last balance check, enabled flag).
model SupplierConfig {
  id            String    @id @default(cuid())
  // e.g. "DIGITALCORE"
  provider      String    @unique
  isEnabled     Boolean   @default(true)
  lastBalance   Float?
  lastCheckedAt DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@map("supplier_configs")
}

model GoogleDriveConfig {
  id              String    @id @default(cuid())
  clientEmail     String?
  privateKey      String?   // Encrypted
  folderId        String?
  isActive        Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@map("google_drive_configs")
}

model BridgeInboundEvent {
  id                String   @id @default(cuid())
  transactionId     String   @unique          // idempotency (BRG-...)
  source            String                    // "BRIDGE_BOT"
  supplierCode      String
  supplierProductId String
  externalProductId String                    // "RZK-..."
  productId         String?                   // resolved VL Product.id
  addedQty          Int
  insertedQty       Int      @default(0)
  skippedQty        Int      @default(0)      // duplicates
  status            String   @default("PROCESSING") // PROCESSING|COMPLETED|REJECTED
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([status, createdAt])
  @@map("bridge_inbound_events")
}
